<Window x:Class="PortalFp.Login.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PortalFp.Login"
        mc:Ignorable="d"
        Title="PortalFP Login" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">

    <Window.Resources>
        <!-- Paleta sobria y con feedback claro -->
        <Color x:Key="PrimaryColor">#1E3A8A</Color>
        <Color x:Key="AccentColor">#2563EB</Color>
        <Color x:Key="SuccessColor">#059669</Color>
        <Color x:Key="ErrorColor">#DC2626</Color>
        <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
        <Color x:Key="MutedColor">#6B7280</Color>
        <Color x:Key="BorderColor">#D1D5DB</Color>
        <Color x:Key="WindowBgColor">#F3F4F6</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBgColor}"/>

        <!-- Espaciado y radio estándar -->
        <sys:Double x:Key="StandardSpacing">10</sys:Double>
        <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>

        <!-- Estilo simple para botones para mejorar comportamiento visual -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{StaticResource BorderBrushColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20" Cursor="">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Fila 0: Imagen o icono vectorial -->
        <Image Source="/img/logo.png" 
               Margin="0,10,0,14" 
               HorizontalAlignment="Center"
               Width="160"
               Grid.Row="0"/>

        <!-- Fila 1: Label mnemónico (Alt+U) para nombre de usuario -->
        <Label Content="Introduce tu nombre de _usuario:" 
               Target="{Binding ElementName=TxtNombre}"
               FontSize="14" 
               Margin="0,0,0,5" 
               Grid.Row="1"/>

        <!-- Fila 2: TextBox para nombre usuario envuelto en Border (esquinas redondeadas y feedback) -->
        <Border Grid.Row="2" Margin="0,0,0,15" Padding="6" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBox x:Name="TxtNombre"
                     FontSize="14"
                     Padding="4"
                     BorderThickness="0"
                     Background="Transparent"
                     TabIndex="1"
                     AutomationProperties.Name="Entrada para el nombre del usuario"
                     AutomationProperties.HelpText="Escriba aquí su nombre de pila para que la aplicación le salude."/>
        </Border>

        <!-- Fila 3: Label mnemónico (Alt+C) para contrasenya usuario -->
        <Label Content="Introduce tu _contraseña:"
               Target="{Binding ElementName=TxtContrasenya}"
               FontSize="14"
               Margin="0,0,0,5"
               Grid.Row="3"/>


        <!-- Fila 4: PasswordBox envuelto en Border (esquinas redondeadas y feedback) -->
        <Border Grid.Row="4" Margin="0,0,0,20" Padding="6" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <PasswordBox x:Name="TxtContrasenya"
                         FontSize="14"
                         Padding="4"
                         BorderThickness="0"
                         Background="Transparent"
                         TabIndex="2"/>
        </Border>

        <!-- Fila 5: Botón envuelto en Border para mantener esquinas redondeadas coherentes -->
        <Border Grid.Row="5" Margin="0,0,0,15" Padding="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Button x:Name="BtnAcceder"
                    Content="Acceder"
                    Style="{StaticResource PrimaryButton}"
                    Grid.Row="5"
                    TabIndex="3"
                    IsDefault="True"
                    AutomationProperties.Name="Botón de acceso"
                    AutomationProperties.HelpText="Al hacer clic o presionar Enter, se iniciara sesión."
                    Click="BtnAcceder_Click"/>
        </Border>

        <!-- Fila 6: Mensaje de feedback -->
        <TextBlock x:Name="TxtFeedback" 
                   FontSize="14" 
                   FontWeight="Bold" 
                   Grid.Row="6" 
                   VerticalAlignment="Center" 
                   Foreground="#FF1976D2"
                   AutomationProperties.LiveSetting="Assertive"/>
        
    </Grid>
</Window>
