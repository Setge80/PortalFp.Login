<Window x:Class="PortalFp.Login.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PortalFp.Login"
        mc:Ignorable="d"
        Title="PortalFP Login" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Fila 0: Imagen o icono vectorial -->
        <Image Source="/img/logo.png" 
               Margin="0,10,0,14" 
               HorizontalAlignment="Center"
               Width="160"
               Grid.Row="0"/>

        <!-- Fila 1: Label mnemónico (Alt+N) para nombre de usuario -->
        <Label Content="Introduce tu _nombre:" 
               Target="{Binding ElementName=TxtNombre}"
               FontSize="14" 
               Margin="0,0,0,5" 
               Grid.Row="1"/>

        <!-- Fila 2: TextBox para nombre usuario con TabIndex y accesibilidad de lector de pantalla -->
        <TextBox x:Name="TxtNombre" 
                 FontSize="14" 
                 Padding="5" 
                 Margin="0,0,0,15"
                 Grid.Row="2" 
                 TabIndex="1"
                 AutomationProperties.Name="Entrada para el nombre del usuario"
                 AutomationProperties.HelpText="Escriba aquí su nombre de pila para que la
                 aplicación le salude."/>

        <!-- Fila 3: Label mnemónico (Alt+C) para contrasenya usuario -->
        <Label Content="Introduce tu _contraseña:"
               Target="{Binding ElementName=TxtContrasenya}"
               FontSize="14"
               Margin="0,0,0,5"
               Grid.Row="3"/>


        <!-- Fila 4: PasswordBox para contrasenya usuario con TabIndex -->
        <PasswordBox x:Name="TxtContrasenya"
                     FontSize="14" 
                     Margin="0,0,0,20"
                     Grid.Row="4"
                     TabIndex="2"/>

        <!-- Fila 5: Contenedor para el botón con IsDefault y TabIndex -->
        <Button x:Name="BtnAcceder" 
                Content="Acceder" 
                Click="BtnAcceder_Click"
                Padding="10,5" 
                FontSize="14"
                Margin="0,0,0,15"
                Cursor="Hand" 
                Grid.Row="5"
                TabIndex="3" 
                IsDefault="True"
                AutomationProperties.Name="Botón de acceso"
                AutomationProperties.HelpText="Al hacer clic o presionar Enter, se iniciara
                sesión."/>

        <!-- Fila 6: Mensaje de feedback -->
        <TextBlock x:Name="TxtFeedback" 
                   FontSize="14" 
                   FontWeight="Bold" 
                   Grid.Row="6" 
                   VerticalAlignment="Center" 
                   Foreground="#FF1976D2"
                   AutomationProperties.LiveSetting="Assertive"/>
        
    </Grid>
</Window>
